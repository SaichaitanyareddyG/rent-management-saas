# Backend Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to Git!

# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/rent_app
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here

# JWT Configuration (generate with: openssl rand -base64 32)
JWT_SECRET=changeme_generate_secure_256_bit_key_here
JWT_EXPIRATION=86400000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Logging
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_RENTAPP=DEBUG

# Actuator (Health Check)
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics

# Profile (development, production)
SPRING_PROFILES_ACTIVE=development
